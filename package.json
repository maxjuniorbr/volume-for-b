  "description": "Boost Chrome tab audio up to 600% with per-tab control and local processing.",
  "author": "Dianin",
  "license": "MIT",
  "homepage": "https://maxjuniorbr.github.io/volume-for-b/",
  "repository": {
    "type": "git",
